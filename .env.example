# Copy to .env to change the defaults; `docker compose` reads .env from this directory.

# Host port for everything: the API, / (test page), /docs and /site/ (docs site).
TEAM_NOTES_PORT=8765
# Host address to publish on. 0.0.0.0 makes it reachable from other machines.
TEAM_NOTES_BIND=127.0.0.1
# 1: seed the demo data (docs/SEED_DATA.md) when the database has no accounts. 0: never.
TEAM_NOTES_SEED=1
# The app's Postgres password. Unset: the demo default `team-notes-demo`, fine for a
# local demo only. Letters and digits only (it goes into a URL), for example the
# output of `openssl rand -hex 24`. Read when the database volume is first created;
# docs/RUNNING.md says how to change it later.
TEAM_NOTES_DB_PASSWORD=
