  {
   "id": "panel-r-body-0",
   "type": "text",
   "x": 1618.0,
   "y": 92,
   "width": 495.04,
   "height": 191.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "seed": 1205998731,
   "version": 1,
   "versionNonce": 602999365,
   "isDeleted": false,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "D1 Isolation: one membership check, 404 outside\nD2 Edit lock: 60 s lease, 10 min idle, If-Match\nD3 Each guarded write: one conditional statement\nD4 Long poll woken by an in-memory notifier\nD5 One store: SQLite, or Postgres as its own service\nD6 40 connections = 40 threads, one per hop\nD7 Cursor-paged lists; search scans one team\nD8 Sync handlers on 40 threads, one async route\nD9 Opaque bearer tokens, argon2 passwords",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "D1 Isolation: one membership check, 404 outside\nD2 Edit lock: 60 s lease, 10 min idle, If-Match\nD3 Each guarded write: one conditional statement\nD4 Long poll woken by an in-memory notifier\nD5 One store: SQLite, or Postgres as its own service\nD6 40 connections = 40 threads, one per hop\nD7 Cursor-paged lists; search scans one team\nD8 Sync handlers on 40 threads, one async route\nD9 Opaque bearer tokens, argon2 passwords",
   "autoResize": true,
   "lineHeight": 1.25
  },
