   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1. Several processes: LISTEN/NOTIFY to each notifier\n2. Search too slow: FTS5 or tsvector, same database\n3. Reads outgrow a machine: replicas for lists\n4. A measured hot read: cache, never membership\n5. Data outgrows a database: shard by team_id",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1. Several processes: LISTEN/NOTIFY to each notifier\n2. Search too slow: FTS5 or tsvector, same database\n3. Reads outgrow a machine: replicas for lists\n4. A measured hot read: cache, never membership\n5. Data outgrows a database: shard by team_id",
   "autoResize": true,
   "lineHeight": 1.25
  }
