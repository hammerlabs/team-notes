   "updated": 1,
   "link": null,
   "locked": false,
   "text": "User, Session (only the token's hash is stored)\nTeam, Membership (team, user, admin | member)\nNote (team, author, title, body, version)\nEdit lock: columns on Note, holder, expiry, activity\nTag: version + live holder; viewers wait on it",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "User, Session (only the token's hash is stored)\nTeam, Membership (team, user, admin | member)\nNote (team, author, title, body, version)\nEdit lock: columns on Note, holder, expiry, activity\nTag: version + live holder; viewers wait on it",
   "autoResize": true,
   "lineHeight": 1.25
  },
