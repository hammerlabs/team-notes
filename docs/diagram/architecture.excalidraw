  {
   "id": "panel-l-body-0",
   "type": "text",
   "x": -552,
   "y": 92,
   "width": 523.6,
   "height": 233.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "seed": 785594258,
   "version": 1,
   "versionNonce": 392797129,
   "isDeleted": false,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "About 20 teams of up to 50 people (D4)\nUp to 10,000 notes per team, about 2 KB each (D7)\nA list page or a search in under 200 ms (D7)\nAbout 5 writes/s: 100 editors renewing every 20 s (D5)\nViewers hear of a save, lock or unlock within 1 s (D4)\nA waiting viewer holds no thread or connection (D4, D6)\nOutsiders learn nothing about a team (D1)\nNo edit lost silently (D2, D3)\nA crashed editor blocks a note at most 60 s (D2)\nMembership and edits read fresh; lists may lag (G)\nOne command to run, one to test",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "About 20 teams of up to 50 people (D4)\nUp to 10,000 notes per team, about 2 KB each (D7)\nA list page or a search in under 200 ms (D7)\nAbout 5 writes/s: 100 editors renewing every 20 s (D5)\nViewers hear of a save, lock or unlock within 1 s (D4)\nA waiting viewer holds no thread or connection (D4, D6)\nOutsiders learn nothing about a team (D1)\nNo edit lost silently (D2, D3)\nA crashed editor blocks a note at most 60 s (D2)\nMembership and edits read fresh; lists may lag (G)\nOne command to run, one to test",
   "autoResize": true,
   "lineHeight": 1.25
  },
