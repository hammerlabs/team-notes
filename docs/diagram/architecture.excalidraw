   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Concurrent editing: one editor at a time instead\nContent push to viewers, presence, cursors\nRich text, attachments, trash, history, tags\nPrivate notes, per-note sharing, invitations\nRole changes, renaming or deleting teams\nLogout, password reset, SSO, rate limiting\nIdempotency keys, migrations, metrics",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
